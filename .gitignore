data/benchmark/*
!data/benchmark/.gitkeep
!data/benchmark/agentic_rag_evaluation.jsonl
!data/benchmark/retrieval_judgments.jsonl

# Vector / lexical indexes
indexes/*
!indexes/.gitkeep

# Logs
*.log

# Build artifacts
build/
dist/
*.egg-info/