.ipynb_checkpoints/

# Raw data
data/raw/metadata/*
!data/raw/metadata/.gitkeep

data/raw/content/*
!data/raw/content/.gitkeep

# Intermediate data
data/interim/*
!data/interim/.gitkeep

# Processed datasets
data/processed/papers/*
!data/processed/papers/.gitkeep
data/processed/*.json
data/processed/*.jsonl
data/processed/chunks/*
!data/processed/chunks/.gitkeep
data/processed/indexes/*
