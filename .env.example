# Copy to .env and fill in. Never commit .env.

# Answer generation, grading and RAGAS judging (configs/corpus.yaml -> agentic_rag.provider: openai).
OPENAI_API_KEY=

# Web fallback (Tavily). Leave empty to disable the web_search node.
TAVILY_API_KEY=

# Only needed to re-run corpus ingestion from OpenAlex.
OPENALEX_API_KEY=

# Optional: LangSmith tracing for the LangGraph graph and evaluation runs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-research-rag
